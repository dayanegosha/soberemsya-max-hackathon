    "/api/location/resolve": {
      "post": {
        "summary": "Определить город России и точки встречи по геопозиции",
        "operationId": "resolveLocation",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Coordinates"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Город и точки встречи",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/City"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные координаты"
          },
          "503": {
            "description": "Сервис геоданных временно недоступен"
          }
        }
      }
    },
    "/api/location/search": {
      "get": {
        "summary": "Найти город России по названию",
        "operationId": "searchRussianCities",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Найденные города",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cities"
                  ],
                  "properties": {
                    "cities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/City"
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Сервис геоданных временно недоступен"
          }
        }
      }
    },
