# Copy to .env; never commit real secrets. Demo needs no token.
BOT_TOKEN=
MAX_BOT_USERNAME=
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
PORT=3000
HOST=127.0.0.1
ALLOW_DEMO=true
DB_PATH=var/soberemsya.sqlite
# Set only if you intend to replace an existing bot webhook.
MAX_ALLOW_WEBHOOK_REPLACE=false

# Only for compose.server.yaml; DNS must point to this server.
APP_DOMAIN=
